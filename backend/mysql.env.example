# Copy to backend/.env for direct Python startup. Never commit the real .env.
# For Compose: docker compose --env-file backend/.env ...
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ontology_db
MYSQL_USER=ontology_app
MYSQL_PASSWORD=REPLACE_WITH_DEDICATED_DATABASE_PASSWORD
# Optional trusted CA path, also mounted inside the container if using Docker.
MYSQL_SSL_CA=
