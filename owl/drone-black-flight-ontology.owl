<?xml version="1.0" encoding="UTF-8"?>
<!--
  元枢本体 · 无人机黑飞预警场景本体（OWL 2）
  数据契约来源：docs/mqtt使用说明.md + docs/mqtt消息.txt（minsim 仿真引擎 telemetry 报文）
  导入方式：python scripts/import_drone_owl.py（backend 目录下执行）

  设计约定：
  1. 属性名与 minsim telemetry 报文字段一一对应（blocks 块内字段拍平）；
  2. 引擎实体 id 仅单次运行内唯一，DroneTarget 以 scenario_id + entity_name 作稳定标识（target_key）；
  3. 三层防膨胀：DroneObservation append-only → DroneState upsert → DroneTarget 稳定对象；
  4. tier / primary_key / required / enum / 真实基数 等 OWL 无法表达的语义，
     由导入脚本按本文件注释中的约定补齐（见 OWL_META 注释段）。
-->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:uav="http://yuanshu.ontology/drone#">

  <owl:Ontology rdf:about="http://yuanshu.ontology/drone">
    <rdfs:label>无人机黑飞预警场景本体</rdfs:label>
    <rdfs:comment>低空无人机目标跟踪与黑飞预警：目标-观测-状态三层建模，对齐 minsim 仿真引擎 MQTT 遥测契约。场景归属 domain = drone。</rdfs:comment>
  </owl:Ontology>

  <!-- ═══════════════ 类（owl:Class → 本体对象） ═══════════════ -->

  <owl:Class rdf:about="http://yuanshu.ontology/drone#DroneTarget">
    <rdfs:label>无人机目标</rdfs:label>
    <rdfs:comment>T1 核心对象 · 稳定业务对象，识别与跟踪主入口。稳定标识 = scenario_id + entity_name（target_key），引擎实体 id 跨运行可复用禁止持久化为主键。tier=1, primary_key=target_key</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#DroneObservation">
    <rdfs:label>原始观测</rdfs:label>
    <rdfs:comment>T1 核心对象 · 每条降采样遥测一条，append-only 只增不改，可治理可回放。tier=1, primary_key=obs_id</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#DroneState">
    <rdfs:label>最新状态</rdfs:label>
    <rdfs:comment>T1 核心对象 · 由有效观测按 target_key upsert，每目标仅一条最新状态，防图谱膨胀。tier=1, primary_key=target_key</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#ProtectedZone">
    <rdfs:label>保护区</rdfs:label>
    <rdfs:comment>T2 领域对象 · 管制空域多边形（WGS-84 经纬度顶点），含高度上限，侵入判定依据。tier=2, primary_key=zone_id</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#FlightAuthorization">
    <rdfs:label>飞行授权</rdfs:label>
    <rdfs:comment>T2 领域对象 · 空域使用许可，无授权飞行判定（R2）依据。tier=2, primary_key=auth_id</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#JammerDevice">
    <rdfs:label>干扰反制设备</rdfs:label>
    <rdfs:comment>T2 领域对象 · 对应遥测 jammer 块（blocks 位 64），干扰源配置与本帧发射状态。tier=2, primary_key=device_id</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#RiskAssessment">
    <rdfs:label>风险评估</rdfs:label>
    <rdfs:comment>T3 场景对象 · 规则/函数计算产出（综合威胁评分、ETA、置信度），含证据链。tier=3, primary_key=assessment_id</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://yuanshu.ontology/drone#WarningEvent">
    <rdfs:label>预警事件</rdfs:label>
    <rdfs:comment>T3 场景对象 · 规则命中后的预警记录（P0/P1/P2），驱动态势事件流与处置行动。tier=3, primary_key=event_id</rdfs:comment>
  </owl:Class>

  <!-- ═══════════════ 对象属性（owl:ObjectProperty → 关系） ═══════════════
       导入脚本按注释补齐真实基数：observed_by N:1 · current_state 1:1 ·
       inside_zone N:1 · authorized_by N:1 · assessed_target N:1 · triggered_event 1:N -->

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#observed_by">
    <rdfs:label>观测归属目标</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#current_state">
    <rdfs:label>当前状态</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#inside_zone">
    <rdfs:label>位于保护区</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#authorized_by">
    <rdfs:label>飞行授权</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#assessed_target">
    <rdfs:label>评估针对目标</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://yuanshu.ontology/drone#triggered_event">
    <rdfs:label>触发预警事件</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
  </owl:ObjectProperty>

  <!-- ═══════════════ DroneTarget 数据属性 ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#target_key">
    <rdfs:label>目标稳定标识（scenario_id + entity_name，主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#scenario_id">
    <rdfs:label>场景号（引擎自动分配递增）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#entity_name">
    <rdfs:label>实体名（遥测 name 字段）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#first_seen_at">
    <rdfs:label>首次发现时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#last_seen_at">
    <rdfs:label>最近发现时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#tracking_status">
    <rdfs:label>跟踪状态（tracking/lost）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneTarget"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ DroneObservation 数据属性（逐字对齐遥测报文） ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#obs_id">
    <rdfs:label>观测记录主键（client+scenario_id+tick+entity_name 幂等）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#client">
    <rdfs:label>会话标记（空串为默认会话）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#tick">
    <rdfs:label>推演步号（从 1 递增）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#sim_time_s">
    <rdfs:label>仿真时刻（秒 = tick × 步长）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#sim_entity_id">
    <rdfs:label>引擎实体 id（仅单次运行内唯一，勿作主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#blocks">
    <rdfs:label>块位掩码（1 transform/2 motion/4 flight/8 faction/16 rf_link/32 health/64 jammer）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#latitude_deg">
    <rdfs:label>纬度（WGS-84，transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#longitude_deg">
    <rdfs:label>经度（WGS-84，transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#altitude_m">
    <rdfs:label>海拔高度 m（transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#yaw_deg">
    <rdfs:label>航向（0=正北顺时针，transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#pitch_deg">
    <rdfs:label>俯仰角（transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#roll_deg">
    <rdfs:label>滚转角（transform 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#speed_mps">
    <rdfs:label>地速 m/s（motion 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#airspeed_mps">
    <rdfs:label>空速 m/s（flight 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#observed_at">
    <rdfs:label>观测落库时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ DroneState 数据属性（观测层 upsert 拍平） ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_last_tick">
    <rdfs:label>状态对应最新 tick</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_motion_mode">
    <rdfs:label>运动模式（0 静止/1 巡航/2 失控/3 下坠/4 返航/5 已摧毁/6 沿航路）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_faction_side">
    <rdfs:label>阵营（0 中立/1 红方/2 蓝方）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_latitude_deg">
    <rdfs:label>最新纬度</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_longitude_deg">
    <rdfs:label>最新经度</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_altitude_m">
    <rdfs:label>最新高度 m</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_speed_mps">
    <rdfs:label>最新地速 m/s</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#gnss_locked">
    <rdfs:label>卫导锁定（false 将判 FALLING）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#rc_linked">
    <rdfs:label>遥控链路在线（false 将判 LOST_LINK）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#telemetry_linked">
    <rdfs:label>遥测链路在线</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#gnss_sir_db">
    <rdfs:label>卫导干信比 dB</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#rc_sir_db">
    <rdfs:label>遥控干信比 dB</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#hp">
    <rdfs:label>当前生命值（health 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#max_hp">
    <rdfs:label>最大生命值</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#destroyed">
    <rdfs:label>是否已摧毁（health 块）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#state_updated_at">
    <rdfs:label>状态更新时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#DroneState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ ProtectedZone 数据属性 ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#zone_id">
    <rdfs:label>保护区编号（主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#zone_name">
    <rdfs:label>保护区名称</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#zone_type">
    <rdfs:label>保护区类型（core/backup/restricted）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#polygon_wkt">
    <rdfs:label>多边形边界（WGS-84 经纬度 WKT）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#ceil_alt_m">
    <rdfs:label>高度上限 m（侵入判定阈值）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#ProtectedZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ FlightAuthorization 数据属性 ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#auth_id">
    <rdfs:label>授权编号（主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#authorization_no">
    <rdfs:label>许可文号（如 FA-2026-018）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#auth_target_key">
    <rdfs:label>授权目标（DroneTarget.target_key）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#valid_from">
    <rdfs:label>生效时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#valid_until">
    <rdfs:label>失效时间（无授权判定依据）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#auth_status">
    <rdfs:label>授权状态（valid/expired/revoked）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#FlightAuthorization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ JammerDevice 数据属性（jammer 块 · blocks 位 64） ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#device_id">
    <rdfs:label>设备编号（主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#jammer_enabled">
    <rdfs:label>设备总开关</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#jammer_emitting">
    <rdfs:label>本帧实际发射状态（含通断周期判定）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#jammer_style">
    <rdfs:label>干扰样式（0 阻塞/1 瞄准/2 扫频）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#eirp_dbm">
    <rdfs:label>有效辐射功率 dBm</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#freq_hz">
    <rdfs:label>中心频率 Hz（如 1575420000）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#bandwidth_hz">
    <rdfs:label>干扰带宽 Hz</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#boresight_yaw_deg">
    <rdfs:label>波束指向方位角（0=正北顺时针）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#boresight_pitch_deg">
    <rdfs:label>波束指向俯仰角</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#half_angle_deg">
    <rdfs:label>主瓣半锥角（≤0 视为全向）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#sidelobe_gain_dbi">
    <rdfs:label>旁瓣增益 dBi</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#JammerDevice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ RiskAssessment 数据属性 ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#assessment_id">
    <rdfs:label>评估编号（主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#risk_score">
    <rdfs:label>综合威胁评分（0-100）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#risk_level">
    <rdfs:label>风险等级（low/medium/high/critical）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#eta_seconds">
    <rdfs:label>抵达保护区预计秒数</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#eta_confidence">
    <rdfs:label>ETA 置信度（0-1）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#inside_zone">
    <rdfs:label>是否已侵入保护区</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#evidence">
    <rdfs:label>证据链（命中规则与引用属性值，JSON）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#assessed_at">
    <rdfs:label>评估时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <!-- ═══════════════ WarningEvent 数据属性 ═══════════════ -->

  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#event_id">
    <rdfs:label>事件编号（主键）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#warning_type">
    <rdfs:label>预警类型（zone_intrusion/no_authorization/approach/gnss_lost/rc_lost/destruction）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#priority">
    <rdfs:label>优先级（P0/P1/P2）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#event_status">
    <rdfs:label>处置状态（open/processing/closed）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#hit_rule_name">
    <rdfs:label>命中规则名（证据链引用）</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#event_description">
    <rdfs:label>事件描述</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://yuanshu.ontology/drone#triggered_at">
    <rdfs:label>触发时间</rdfs:label>
    <rdfs:domain rdf:resource="http://yuanshu.ontology/drone#WarningEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

</rdf:RDF>
